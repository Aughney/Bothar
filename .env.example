# Privy app ID — create a free app at https://dashboard.privy.io
# Without this, the app runs but Privy login is disabled.
NEXT_PUBLIC_PRIVY_APP_ID=

# Privy verification key — from https://dashboard.privy.io/settings/embedded-wallets
# Used to verify wallet signatures on the server.
PRIVY_VERIFICATION_KEY="-----BEGIN PUBLIC KEY-----
<your-verification-key>
-----END PUBLIC KEY-----"

# Neon Postgres connection string — provisioned via Vercel Marketplace → Storage → Neon
# See BACKEND.md §2 for setup instructions.
DATABASE_URL=

# Resend — transactional email (https://resend.com, free tier)
# Used to notify drivers of seat requests and passengers of accept/decline decisions.
RESEND_API_KEY=
RESEND_FROM_EMAIL=Bóthar <noreply@yourdomain.com>
